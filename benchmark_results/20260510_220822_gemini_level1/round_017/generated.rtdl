def task PickAndPlaceCUP(;){ state s1: bool; state m1: string; state s2: bool; state m2: string; state s3: bool; state m3: string; state s4: bool; state m4: string; sequence{ do NavTo(robot_name="CAR", x=2.0, y=2.0, tolerance=0.5; success->s1, message->m1); check(s1 == true); do Pick(robot_name="CAR", object_name="CUP"; success->s2, message->m2); check(s2 == true); do NavTo(robot_name="CAR", x=-2.0, y=2.0, tolerance=0.5; success->s3, message->m3); check(s3 == true); do Place(robot_name="CAR", object_name="CUP", location_name="TABLE"; success->s4, message->m4); check(s4 == true); } }