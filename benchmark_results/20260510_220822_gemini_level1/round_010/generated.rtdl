def task PickAndPlaceCUPOnTABLE(;){ state nav_success_1: bool; state nav_msg_1: string; state pick_success: bool; state pick_msg: string; state nav_success_2: bool; state nav_msg_2: string; state place_success: bool; state place_msg: string; sequence{ do NavTo(robot_name="CAR", x=2.0, y=2.0, tolerance=0.5; success->nav_success_1, message->nav_msg_1); check(nav_success_1 == true); do Pick(robot_name="CAR", object_name="CUP"; success->pick_success, message->pick_msg); check(pick_success == true); do NavTo(robot_name="CAR", x=-2.0, y=2.0, tolerance=0.5; success->nav_success_2, message->nav_msg_2); check(nav_success_2 == true); do Place(robot_name="CAR", object_name="CUP", location_name="TABLE"; success->place_success, message->place_msg); check(place_success == true); } }