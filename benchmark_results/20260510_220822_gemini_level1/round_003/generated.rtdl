def task PickAndPlace(;){ state nav1_suc: bool; state nav1_msg: string; state pick_suc: bool; state pick_msg: string; state nav2_suc: bool; state nav2_msg: string; state place_suc: bool; state place_msg: string; sequence{ do NavTo(robot_name="CAR",x=2.0,y=2.0,tolerance=0.5;success->nav1_suc,message->nav1_msg); check(nav1_suc == true); do Pick(robot_name="CAR",object_name="CUP";success->pick_suc,message->pick_msg); check(pick_suc == true); do NavTo(robot_name="CAR",x=-2.0,y=2.0,tolerance=0.5;success->nav2_suc,message->nav2_msg); check(nav2_suc == true); do Place(robot_name="CAR",object_name="CUP",location_name="TABLE";success->place_suc,message->place_msg); check(place_suc == true); } }