def task PickAndPlace(;){ state nav_s: bool; state nav_m: string; state pick_s: bool; state pick_m: string; state place_s: bool; state place_m: string; sequence{ do NavTo(robot_name="CAR", x=2.0, y=2.0, tolerance=0.5; success->nav_s, message->nav_m); check(nav_s == true); do Pick(robot_name="CAR", object_name="CUP"; success->pick_s, message->pick_m); check(pick_s == true); do NavTo(robot_name="CAR", x=-2.0, y=2.0, tolerance=0.5; success->nav_s, message->nav_m); check(nav_s == true); do Place(robot_name="CAR", object_name="CUP", location_name="TABLE"; success->place_s, message->place_m); check(place_s == true); } }