def task PickAndPlaceCUP(;){ state nav_succ1: bool; state nav_msg1: string; state pick_succ: bool; state pick_msg: string; state nav_succ2: bool; state nav_msg2: string; state place_succ: bool; state place_msg: string; sequence{ do NavTo(robot_name="CAR", x=2.0, y=2.0, tolerance=0.1; success->nav_succ1, message->nav_msg1); check(nav_succ1 == true); do Pick(robot_name="CAR", object_name="CUP"; success->pick_succ, message->pick_msg); check(pick_succ == true); do NavTo(robot_name="CAR", x=-2.0, y=2.0, tolerance=0.1; success->nav_succ2, message->nav_msg2); check(nav_succ2 == true); do Place(robot_name="CAR", object_name="CUP", location_name="TABLE"; success->place_succ, message->place_msg); check(place_succ == true); } }