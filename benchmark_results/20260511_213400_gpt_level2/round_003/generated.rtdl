def task ClearObstacleAndPlaceBottle(;){
    state nav1_success: bool;
    state nav1_message: string;
    state pick1_success: bool;
    state pick1_message: string;
    state nav2_success: bool;
    state nav2_message: string;
    state place1_success: bool;
    state place1_message: string;
    state nav3_success: bool;
    state nav3_message: string;
    state pick2_success: bool;
    state pick2_message: string;
    state nav4_success: bool;
    state nav4_message: string;
    state place2_success: bool;
    state place2_message: string;

    sequence{
        retry(3) do NavTo(robot_name="CAR",x=1.849739245314929,y=1.4997831962552963,tolerance=0.5;success->nav1_success,message->nav1_message);
        check(nav1_success == true);
        retry(3) do Pick(robot_name="CAR",object_name="FRONT_CRATE";success->pick1_success,message->pick1_message);
        check(pick1_success == true);
        retry(3) do NavTo(robot_name="CAR",x=-1.9999701842836735,y=-1.7999695985302377,tolerance=0.5;success->nav2_success,message->nav2_message);
        check(nav2_success == true);
        do Place(robot_name="CAR",object_name="FRONT_CRATE",location_name="TEMP_ZONE";success->place1_success,message->place1_message);
        check(place1_success == true);
        retry(3) do NavTo(robot_name="CAR",x=2.55,y=1.5,tolerance=0.5;success->nav3_success,message->nav3_message);
        check(nav3_success == true);
        retry(3) do Pick(robot_name="CAR",object_name="MEDICINE_BOTTLE";success->pick2_success,message->pick2_message);
        check(pick2_success == true);
        retry(3) do NavTo(robot_name="CAR",x=-2.3,y=2.0,tolerance=0.5;success->nav4_success,message->nav4_message);
        check(nav4_success == true);
        do Place(robot_name="CAR",object_name="MEDICINE_BOTTLE",location_name="MEDICAL_TABLE";success->place2_success,message->place2_message);
        check(place2_success == true);
    }
}