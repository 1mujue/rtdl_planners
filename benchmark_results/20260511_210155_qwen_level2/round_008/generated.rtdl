def task MoveMedicineToTable(;){
    state nav_crate: bool;
    state pick_crate: bool;
    state nav_zone: bool;
    state place_crate: bool;
    state nav_bottle: bool;
    state pick_bottle: bool;
    state nav_table: bool;
    state place_bottle: bool;

    sequence{
        do NavTo(robot_name="CAR", x=1.8497391827655587, y=1.4997831388276834, tolerance=1.0; success->nav_crate);
        check(nav_crate == true);

        do Pick(robot_name="CAR", object_name="FRONT_CRATE"; success->pick_crate);
        check(pick_crate == true);

        do NavTo(robot_name="CAR", x=-1.9999700483276848, y=-1.799969434030035, tolerance=1.0; success->nav_zone);
        check(nav_zone == true);

        do Place(robot_name="CAR", object_name="FRONT_CRATE", location_name="TEMP_ZONE"; success->place_crate);
        check(place_crate == true);

        do NavTo(robot_name="CAR", x=2.55, y=1.5, tolerance=1.0; success->nav_bottle);
        check(nav_bottle == true);

        do Pick(robot_name="CAR", object_name="MEDICINE_BOTTLE"; success->pick_bottle);
        check(pick_bottle == true);

        do NavTo(robot_name="CAR", x=-2.3, y=2.0, tolerance=1.0; success->nav_table);
        check(nav_table == true);

        do Place(robot_name="CAR", object_name="MEDICINE_BOTTLE", location_name="MEDICAL_TABLE"; success->place_bottle);
        check(place_bottle == true);
    }
}