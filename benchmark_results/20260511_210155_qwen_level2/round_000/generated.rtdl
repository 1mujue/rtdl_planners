def task place_medicine_bottle(;){
    state s1: bool;
    state s2: bool;
    state s3: bool;
    state s4: bool;
    state s5: bool;
    state s6: bool;
    state s7: bool;
    sequence{
        do Pick(robot_name="CAR", object_name="FRONT_CRATE"; success->s1);
        check(s1 == true);
        do NavTo(robot_name="CAR", x=-2.0, y=-1.8, tolerance=0.5; success->s2);
        check(s2 == true);
        do Place(robot_name="CAR", object_name="FRONT_CRATE", location_name="TEMP_ZONE"; success->s3);
        check(s3 == true);
        do NavTo(robot_name="CAR", x=2.55, y=1.5, tolerance=0.5; success->s4);
        check(s4 == true);
        do Pick(robot_name="CAR", object_name="MEDICINE_BOTTLE"; success->s5);
        check(s5 == true);
        do NavTo(robot_name="CAR", x=-2.3, y=2.0, tolerance=0.5; success->s6);
        check(s6 == true);
        do Place(robot_name="CAR", object_name="MEDICINE_BOTTLE", location_name="MEDICAL_TABLE"; success->s7);
        check(s7 == true);
    }
}