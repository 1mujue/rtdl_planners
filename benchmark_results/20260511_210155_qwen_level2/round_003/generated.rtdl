def task TaskMain(;){
    state ok: bool;
    state msg: string;
    sequence{
        do NavTo(robot_name="CAR", x=1.85, y=1.5, tolerance=0.5; success->ok, message->msg);
        check(ok == true);
        do Pick(robot_name="CAR", object_name="FRONT_CRATE"; success->ok, message->msg);
        check(ok == true);
        do NavTo(robot_name="CAR", x=-2.0, y=-1.8, tolerance=0.5; success->ok, message->msg);
        check(ok == true);
        do Place(robot_name="CAR", object_name="FRONT_CRATE", location_name="TEMP_ZONE"; success->ok, message->msg);
        check(ok == true);
        do NavTo(robot_name="CAR", x=2.55, y=1.5, tolerance=0.5; success->ok, message->msg);
        check(ok == true);
        do Pick(robot_name="CAR", object_name="MEDICINE_BOTTLE"; success->ok, message->msg);
        check(ok == true);
        do NavTo(robot_name="CAR", x=-2.3, y=2.0, tolerance=0.5; success->ok, message->msg);
        check(ok == true);
        do Place(robot_name="CAR", object_name="MEDICINE_BOTTLE", location_name="MEDICAL_TABLE"; success->ok, message->msg);
        check(ok == true);
    }
}