def task PlaceMedicine(;){
    state obstacle_picked: bool;
    state obstacle_placed: bool;
    state nav_to_medicine: bool;
    state medicine_picked: bool;
    state nav_to_table: bool;
    state medicine_placed: bool;
    state tmp_bool: bool;
    state tmp_str: string;

    sequence{
        # Pick up the FRONT_CRATE
        do Pick(robot_name="CAR",object_name="FRONT_CRATE"; success->obstacle_picked, message->tmp_str);
        check(obstacle_picked == true);

        # Place the FRONT_CRATE on TEMP_ZONE
        do Place(robot_name="CAR",object_name="FRONT_CRATE",location_name="TEMP_ZONE"; success->obstacle_placed, message->tmp_str);
        check(obstacle_placed == true);

        # Navigate to the MEDICINE_BOTTLE location (x=2.55, y=1.5)
        do NavTo(robot_name="CAR",x=2.55,y=1.5,tolerance=0.5; success->nav_to_medicine, message->tmp_str);
        check(nav_to_medicine == true);

        # Pick up MEDICINE_BOTTLE
        do Pick(robot_name="CAR",object_name="MEDICINE_BOTTLE"; success->medicine_picked, message->tmp_str);
        check(medicine_picked == true);

        # Navigate to MEDICAL_TABLE location (x=-2.3, y=2.0)
        do NavTo(robot_name="CAR",x=-2.3,y=2.0,tolerance=0.5; success->nav_to_table, message->tmp_str);
        check(nav_to_table == true);

        # Place MEDICINE_BOTTLE on MEDICAL_TABLE
        do Place(robot_name="CAR",object_name="MEDICINE_BOTTLE",location_name="MEDICAL_TABLE"; success->medicine_placed, message->tmp_str);
        check(medicine_placed == true);
    }
}