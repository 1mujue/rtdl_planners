def task place_medicine(;){
    state nav1_ok: bool;
    state nav1_msg: string;
    state pick_crate_ok: bool;
    state pick_crate_msg: string;
    state nav2_ok: bool;
    state nav2_msg: string;
    state place_crate_ok: bool;
    state place_crate_msg: string;
    state nav3_ok: bool;
    state nav3_msg: string;
    state pick_bottle_ok: bool;
    state pick_bottle_msg: string;
    state nav4_ok: bool;
    state nav4_msg: string;
    state place_bottle_ok: bool;
    state place_bottle_msg: string;

    sequence{
        do NavTo(robot_name="CAR",x=1.85,y=1.5,tolerance=0.5;success->nav1_ok,message->nav1_msg);
        check(nav1_ok == true);
        do Pick(robot_name="CAR",object_name="FRONT_CRATE";success->pick_crate_ok,message->pick_crate_msg);
        check(pick_crate_ok == true);
        do NavTo(robot_name="CAR",x=-2.0,y=-1.8,tolerance=0.5;success->nav2_ok,message->nav2_msg);
        check(nav2_ok == true);
        do Place(robot_name="CAR",object_name="FRONT_CRATE",location_name="TEMP_ZONE";success->place_crate_ok,message->place_crate_msg);
        check(place_crate_ok == true);
        do NavTo(robot_name="CAR",x=2.55,y=1.5,tolerance=0.5;success->nav3_ok,message->nav3_msg);
        check(nav3_ok == true);
        do Pick(robot_name="CAR",object_name="MEDICINE_BOTTLE";success->pick_bottle_ok,message->pick_bottle_msg);
        check(pick_bottle_ok == true);
        do NavTo(robot_name="CAR",x=-2.3,y=2.0,tolerance=0.5;success->nav4_ok,message->nav4_msg);
        check(nav4_ok == true);
        do Place(robot_name="CAR",object_name="MEDICINE_BOTTLE",location_name="MEDICAL_TABLE";success->place_bottle_ok,message->place_bottle_msg);
        check(place_bottle_ok == true);
    }
}