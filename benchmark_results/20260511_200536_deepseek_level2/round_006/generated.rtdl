def task PlaceMedicineOnTable(;){
    state nav_success: bool;
    state pick_success: bool;
    state nav2_success: bool;
    state place_success: bool;
    state msg: string;
    sequence{
        do NavTo(robot_name="CAR", x=2.3, y=1.5, tolerance=1.0; success->nav_success, message->msg);
        check(nav_success == true);
        do Pick(robot_name="CAR", object_name="MEDICINE_BOTTLE"; success->pick_success, message->msg);
        check(pick_success == true);
        do NavTo(robot_name="CAR", x=-2.3, y=2.0, tolerance=1.0; success->nav2_success, message->msg);
        check(nav2_success == true);
        do Place(robot_name="CAR", object_name="MEDICINE_BOTTLE", location_name="MEDICAL_TABLE"; success->place_success, message->msg);
    }
}