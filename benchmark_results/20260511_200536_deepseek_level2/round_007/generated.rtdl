def task PlaceMedicineOnTable(;){
    state nav_ok: bool;
    state pick_ok: bool;
    state place_ok: bool;
    state msg: string;

    sequence{
        # Step 1: Navigate to FRONT_CRATE (obstacle)
        do NavTo(robot_name="CAR",x=1.8500960475358783,y=1.5000811144174018,tolerance=0.3; success->nav_ok, message->msg);
        check(nav_ok == true);

        # Step 2: Pick up FRONT_CRATE
        do Pick(robot_name="CAR",object_name="FRONT_CRATE"; success->pick_ok, message->msg);
        check(pick_ok == true);

        # Step 3: Navigate to TEMP_ZONE
        do NavTo(robot_name="CAR",x=-2.0000000864106324,y=-1.80000008816028,tolerance=0.3; success->nav_ok, message->msg);
        check(nav_ok == true);

        # Step 4: Place FRONT_CRATE on TEMP_ZONE
        do Place(robot_name="CAR",object_name="FRONT_CRATE",location_name="TEMP_ZONE"; success->place_ok, message->msg);
        check(place_ok == true);

        # Step 5: Navigate to MEDICINE_BOTTLE
        do NavTo(robot_name="CAR",x=2.55,y=1.5,tolerance=0.3; success->nav_ok, message->msg);
        check(nav_ok == true);

        # Step 6: Pick up MEDICINE_BOTTLE
        do Pick(robot_name="CAR",object_name="MEDICINE_BOTTLE"; success->pick_ok, message->msg);
        check(pick_ok == true);

        # Step 7: Navigate to MEDICAL_TABLE
        do NavTo(robot_name="CAR",x=-2.3,y=2.0,tolerance=0.3; success->nav_ok, message->msg);
        check(nav_ok == true);

        # Step 8: Place MEDICINE_BOTTLE on MEDICAL_TABLE
        do Place(robot_name="CAR",object_name="MEDICINE_BOTTLE",location_name="MEDICAL_TABLE"; success->place_ok, message->msg);
        check(place_ok == true);
    }
}