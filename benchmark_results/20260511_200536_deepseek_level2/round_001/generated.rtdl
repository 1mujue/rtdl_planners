def task Place_Medicine_Bottle(;){
    state s1: bool;
    state msg: string;
    state s2: bool;
    state s3: bool;
    state s4: bool;
    state s5: bool;
    state s6: bool;
    state s7: bool;

    sequence{
        # Navigate to FRONT_CRATE
        do NavTo(robot_name="CAR", x=1.8554886324968243, y=1.4999987108987332, tolerance=0.3; success->s1, message->msg);
        check(s1 == true);

        # Pick up FRONT_CRATE
        do Pick(robot_name="CAR", object_name="FRONT_CRATE"; success->s2, message->msg);
        check(s2 == true);

        # Navigate to TEMP_ZONE
        do NavTo(robot_name="CAR", x=-2.0, y=-1.8, tolerance=0.3; success->s3, message->msg);
        check(s3 == true);

        # Place FRONT_CRATE on TEMP_ZONE
        do Place(robot_name="CAR", object_name="FRONT_CRATE", location_name="TEMP_ZONE"; success->s4, message->msg);
        check(s4 == true);

        # Navigate to MEDICINE_BOTTLE
        do NavTo(robot_name="CAR", x=2.55, y=1.5, tolerance=0.3; success->s5, message->msg);
        check(s5 == true);

        # Pick up MEDICINE_BOTTLE
        do Pick(robot_name="CAR", object_name="MEDICINE_BOTTLE"; success->s6, message->msg);
        check(s6 == true);

        # Navigate to MEDICAL_TABLE
        do NavTo(robot_name="CAR", x=-2.3, y=2.0, tolerance=0.3; success->s7, message->msg);
        check(s7 == true);

        # Place MEDICINE_BOTTLE on MEDICAL_TABLE
        do Place(robot_name="CAR", object_name="MEDICINE_BOTTLE", location_name="MEDICAL_TABLE"; success->s8, message->msg);
    }
}