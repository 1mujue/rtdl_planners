def task PlaceMedicineBottleOnTable(;){
    state nav1_success: bool;
    state nav1_msg: string;
    state pick1_success: bool;
    state pick1_msg: string;
    state nav2_success: bool;
    state nav2_msg: string;
    state place1_success: bool;
    state place1_msg: string;
    state nav3_success: bool;
    state nav3_msg: string;
    state pick2_success: bool;
    state pick2_msg: string;
    state nav4_success: bool;
    state nav4_msg: string;
    state place2_success: bool;
    state place2_msg: string;

    sequence{
        retry(2) do Pick(robot_name="CAR", object_name="FRONT_CRATE"; success->pick1_success, message->pick1_msg);
        check(pick1_success == true);

        retry(2) do NavTo(robot_name="CAR", x=-2.0, y=-1.8, tolerance=0.5; success->nav2_success, message->nav2_msg);
        check(nav2_success == true);

        retry(2) do Place(robot_name="CAR", object_name="FRONT_CRATE", location_name="TEMP_ZONE"; success->place1_success, message->place1_msg);
        check(place1_success == true);

        retry(2) do NavTo(robot_name="CAR", x=2.55, y=1.5, tolerance=0.5; success->nav3_success, message->nav3_msg);
        check(nav3_success == true);

        retry(2) do Pick(robot_name="CAR", object_name="MEDICINE_BOTTLE"; success->pick2_success, message->pick2_msg);
        check(pick2_success == true);

        retry(2) do NavTo(robot_name="CAR", x=-2.3, y=2.0, tolerance=0.5; success->nav4_success, message->nav4_msg);
        check(nav4_success == true);

        retry(2) do Place(robot_name="CAR", object_name="MEDICINE_BOTTLE", location_name="MEDICAL_TABLE"; success->place2_success, message->place2_msg);
        check(place2_success == true);
    }
}