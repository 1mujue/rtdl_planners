def task RemoveMiddleBox(;){
    state nav1_success: bool;
    state nav1_message: string;
    state pick_top_success: bool;
    state pick_top_message: string;
    state nav2_success: bool;
    state nav2_message: string;
    state place_top_temp_success: bool;
    state place_top_temp_message: string;
    state nav3_success: bool;
    state nav3_message: string;
    state pick_middle_success: bool;
    state pick_middle_message: string;
    state nav4_success: bool;
    state nav4_message: string;
    state place_middle_success: bool;
    state place_middle_message: string;
    state nav5_success: bool;
    state nav5_message: string;
    state pick_top_again_success: bool;
    state pick_top_again_message: string;
    state nav6_success: bool;
    state nav6_message: string;
    state place_top_on_bottom_success: bool;
    state place_top_on_bottom_message: string;

    sequence{
        retry(3) do NavTo(robot_name="CAR",x=2.0,y=-1.0,tolerance=0.5;success->nav1_success,message->nav1_message);
        check(nav1_success == true);
        retry(3) do Pick(robot_name="CAR",object_name="BOX_TOP";success->pick_top_success,message->pick_top_message);
        check(pick_top_success == true);

        retry(3) do NavTo(robot_name="CAR",x=-2.2,y=-1.8,tolerance=0.5;success->nav2_success,message->nav2_message);
        check(nav2_success == true);
        retry(3) do Place(robot_name="CAR",object_name="BOX_TOP",location_name="TEMP_TABLE";success->place_top_temp_success,message->place_top_temp_message);
        check(place_top_temp_success == true);

        retry(3) do NavTo(robot_name="CAR",x=2.0,y=-1.0,tolerance=0.5;success->nav3_success,message->nav3_message);
        check(nav3_success == true);
        retry(3) do Pick(robot_name="CAR",object_name="BOX_MIDDLE";success->pick_middle_success,message->pick_middle_message);
        check(pick_middle_success == true);

        retry(3) do NavTo(robot_name="CAR",x=-2.2,y=2.0,tolerance=0.5;success->nav4_success,message->nav4_message);
        check(nav4_success == true);
        retry(3) do Place(robot_name="CAR",object_name="BOX_MIDDLE",location_name="INSPECTION_TABLE";success->place_middle_success,message->place_middle_message);
        check(place_middle_success == true);

        retry(3) do NavTo(robot_name="CAR",x=-2.2,y=-1.8,tolerance=0.5;success->nav5_success,message->nav5_message);
        check(nav5_success == true);
        retry(3) do Pick(robot_name="CAR",object_name="BOX_TOP";success->pick_top_again_success,message->pick_top_again_message);
        check(pick_top_again_success == true);

        retry(3) do NavTo(robot_name="CAR",x=2.0,y=-1.0,tolerance=0.5;success->nav6_success,message->nav6_message);
        check(nav6_success == true);
        retry(3) do Place(robot_name="CAR",object_name="BOX_TOP",location_name="BOX_BOTTOM";success->place_top_on_bottom_success,message->place_top_on_bottom_message);
        check(place_top_on_bottom_success == true);
    }
}