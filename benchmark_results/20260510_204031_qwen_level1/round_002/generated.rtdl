def task PickAndPlaceCup(;){
    state nav1_success: bool;
    state nav1_msg: string;
    state pick_success: bool;
    state pick_msg: string;
    state nav2_success: bool;
    state nav2_msg: string;
    state place_success: bool;
    state place_msg: string;
    sequence{
        do NavTo(robot_name="CAR", x=2.0, y=2.0, tolerance=0.5; success->nav1_success, message->nav1_msg);
        check(nav1_success == true);
        do Pick(robot_name="CAR", object_name="CUP"; success->pick_success, message->pick_msg);
        check(pick_success == true);
        do NavTo(robot_name="CAR", x=-2.0, y=2.0, tolerance=0.5; success->nav2_success, message->nav2_msg);
        check(nav2_success == true);
        do Place(robot_name="CAR", object_name="CUP", location_name="TABLE"; success->place_success, message->place_msg);
    }
}