def task PickCupAndPlaceOnTable(;){
    state nav1_ok: bool;
    state pick_ok: bool;
    state nav2_ok: bool;
    state place_ok: bool;
    state msg: string;
    sequence{
        do NavTo(robot_name="CAR", x=2.0, y=2.0, tolerance=0.5; success->nav1_ok, message->msg);
        check(nav1_ok == true);
        do Pick(robot_name="CAR", object_name="CUP"; success->pick_ok, message->msg);
        check(pick_ok == true);
        do NavTo(robot_name="CAR", x=-2.0, y=2.0, tolerance=0.5; success->nav2_ok, message->msg);
        check(nav2_ok == true);
        do Place(robot_name="CAR", object_name="CUP", location_name="TABLE"; success->place_ok, message->msg);
    }
}