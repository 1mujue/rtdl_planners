def task demoTask(;){
    state success: bool;
    state msg: string;
    state nav_ok: bool;
    state pick_ok: bool;
    state place_ok: bool;
    state top_picked: bool = false;
    state middle_picked: bool = false;

    sequence{
        # Step 1: Navigate near the box stack (coordinates near BOX_BOTTOM)
        do NavTo(robot_name="CAR", x=1.9999999999997866, y=-0.9996906850376268, tolerance=0.5; success->nav_ok, message->msg);
        check(nav_ok == true);

        # Step 2: Pick BOX_TOP (topmost)
        do Pick(robot_name="CAR", object_name="BOX_TOP"; success->pick_ok, message->msg);
        check(pick_ok == true);
        top_picked = true;

        # Step 3: Navigate to TEMP_TABLE to place BOX_TOP temporarily
        do NavTo(robot_name="CAR", x=-2.2, y=-1.8, tolerance=0.5; success->nav_ok, message->msg);
        check(nav_ok == true);

        # Step 4: Place BOX_TOP on TEMP_TABLE
        do Place(robot_name="CAR", object_name="BOX_TOP", location_name="TEMP_TABLE"; success->place_ok, message->msg);
        check(place_ok == true);
        top_picked = false;

        # Step 5: Navigate back to the box stack to pick BOX_MIDDLE
        do NavTo(robot_name="CAR", x=1.9999999999997866, y=-0.9996906850376268, tolerance=0.5; success->nav_ok, message->msg);
        check(nav_ok == true);

        # Step 6: Pick BOX_MIDDLE
        do Pick(robot_name="CAR", object_name="BOX_MIDDLE"; success->pick_ok, message->msg);
        check(pick_ok == true);
        middle_picked = true;

        # Step 7: Navigate to INSPECTION_TABLE
        do NavTo(robot_name="CAR", x=-2.2, y=2.0, tolerance=0.5; success->nav_ok, message->msg);
        check(nav_ok == true);

        # Step 8: Place BOX_MIDDLE on INSPECTION_TABLE
        do Place(robot_name="CAR", object_name="BOX_MIDDLE", location_name="INSPECTION_TABLE"; success->place_ok, message->msg);
        check(place_ok == true);
        middle_picked = false;

        # Step 9: Navigate back to TEMP_TABLE to retrieve BOX_TOP
        do NavTo(robot_name="CAR", x=-2.2, y=-1.8, tolerance=0.5; success->nav_ok, message->msg);
        check(nav_ok == true);

        # Step 10: Pick BOX_TOP from TEMP_TABLE
        do Pick(robot_name="CAR", object_name="BOX_TOP"; success->pick_ok, message->msg);
        check(pick_ok == true);
        top_picked = true;

        # Step 11: Navigate back to original stack location (where BOX_BOTTOM is)
        do NavTo(robot_name="CAR", x=1.9999999999997866, y=-0.9996906850376268, tolerance=0.5; success->nav_ok, message->msg);
        check(nav_ok == true);

        # Step 12: Place BOX_TOP back on BOX_BOTTOM (restoring the stack without BOX_MIDDLE)
        do Place(robot_name="CAR", object_name="BOX_TOP", location_name="BOX_BOTTOM"; success->place_ok, message->msg);
        check(place_ok == true);
        top_picked = false;
    }
}