def task RemoveMiddleBox(;){
    state success1: bool;
    state msg1: string;
    state success2: bool;
    state msg2: string;
    state success3: bool;
    state msg3: string;
    state success4: bool;
    state msg4: string;
    state success5: bool;
    state msg5: string;
    state success6: bool;
    state msg6: string;
    state success7: bool;
    state msg7: string;
    state success8: bool;
    state msg8: string;
    state success9: bool;
    state msg9: string;
    state success10: bool;
    state msg10: string;

    sequence{
        do NavTo(robot_name="CAR",x=2.0,y=-1.0,tolerance=0.5;success->success1,message->msg1);
        check(success1 == true);
        do Pick(robot_name="CAR",object_name="BOX_TOP";success->success2,message->msg2);
        check(success2 == true);
        do NavTo(robot_name="CAR",x=-2.2,y=-1.8,tolerance=0.5;success->success3,message->msg3);
        check(success3 == true);
        do Place(robot_name="CAR",object_name="BOX_TOP",location_name="TEMP_TABLE";success->success4,message->msg4);
        check(success4 == true);
        do NavTo(robot_name="CAR",x=2.0,y=-1.0,tolerance=0.5;success->success5,message->msg5);
        check(success5 == true);
        do Pick(robot_name="CAR",object_name="BOX_MIDDLE";success->success6,message->msg6);
        check(success6 == true);
        do NavTo(robot_name="CAR",x=-2.2,y=2.0,tolerance=0.5;success->success7,message->msg7);
        check(success7 == true);
        do Place(robot_name="CAR",object_name="BOX_MIDDLE",location_name="INSPECTION_TABLE";success->success8,message->msg8);
        check(success8 == true);
        do NavTo(robot_name="CAR",x=-2.2,y=-1.8,tolerance=0.5;success->success9,message->msg9);
        check(success9 == true);
        do Pick(robot_name="CAR",object_name="BOX_TOP";success->success10,message->msg10);
        check(success10 == true);
        do NavTo(robot_name="CAR",x=2.0,y=-1.0,tolerance=0.5;success->success11,message->msg11);
        check(success11 == true);
        do Place(robot_name="CAR",object_name="BOX_TOP",location_name="BOX_BOTTOM";success->success12,message->msg12);
    }
}