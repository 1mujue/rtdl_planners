def task MoveMiddleBox(;){
    state s1: bool;
    state s2: bool;
    state s3: bool;
    state s4: bool;
    state s5: bool;
    state s6: bool;
    state msg: string;

    sequence{
        # Navigate near BOX_BOTTOM (x=2.0, y=-1.0) to reach BOX_TOP
        do NavTo(robot_name="CAR", x=2.0, y=-1.0, tolerance=1.5; success->s1, message->msg);
        check(s1 == true);
        # Pick BOX_TOP
        do Pick(robot_name="CAR", object_name="BOX_TOP"; success->s2, message->msg);
        check(s2 == true);
        # Navigate to TEMP_TABLE (x=-2.2, y=-1.8)
        do NavTo(robot_name="CAR", x=-2.2, y=-1.8, tolerance=1.5; success->s3, message->msg);
        check(s3 == true);
        # Place BOX_TOP on TEMP_TABLE
        do Place(robot_name="CAR", object_name="BOX_TOP", location_name="TEMP_TABLE"; success->s4, message->msg);
        check(s4 == true);
        # Navigate back to the stack location to pick BOX_MIDDLE
        do NavTo(robot_name="CAR", x=2.0, y=-1.0, tolerance=1.5; success->s5, message->msg);
        check(s5 == true);
        # Now BOX_MIDDLE is top; pick it
        do Pick(robot_name="CAR", object_name="BOX_MIDDLE"; success->s6, message->msg);
        check(s6 == true);
        # Navigate to INSPECTION_TABLE (x=-2.2, y=2.0)
        do NavTo(robot_name="CAR", x=-2.2, y=2.0, tolerance=1.5; success->s7, message->msg);
        check(s7 == true);
        # Place BOX_MIDDLE on INSPECTION_TABLE
        do Place(robot_name="CAR", object_name="BOX_MIDDLE", location_name="INSPECTION_TABLE"; success->s8, message->msg);
        check(s8 == true);
        # Go back to TEMP_TABLE to retrieve BOX_TOP
        do NavTo(robot_name="CAR", x=-2.2, y=-1.8, tolerance=1.5; success->s9, message->msg);
        check(s9 == true);
        # Pick BOX_TOP
        do Pick(robot_name="CAR", object_name="BOX_TOP"; success->s10, message->msg);
        check(s10 == true);
        # Navigate back to BOX_BOTTOM
        do NavTo(robot_name="CAR", x=2.0, y=-1.0, tolerance=1.5; success->s11, message->msg);
        check(s11 == true);
        # Place BOX_TOP on BOX_BOTTOM
        do Place(robot_name="CAR", object_name="BOX_TOP", location_name="BOX_BOTTOM"; success->s12, message->msg);
        check(s12 == true);
    }
}