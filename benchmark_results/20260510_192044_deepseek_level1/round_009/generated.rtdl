def task PickAndPlaceCupOnTable(;){
    state success1: bool;
    state msg1: string;
    state success2: bool;
    state msg2: string;
    state success3: bool;
    state msg3: string;
    state success4: bool;
    state msg4: string;

    sequence{
        do NavTo(robot_name="CAR", x=2.0, y=2.0, tolerance=0.5; success->success1, message->msg1);
        check(success1 == true);
        do Pick(robot_name="CAR", object_name="CUP"; success->success2, message->msg2);
        check(success2 == true);
        do NavTo(robot_name="CAR", x=-2.0, y=2.0, tolerance=0.5; success->success3, message->msg3);
        check(success3 == true);
        do Place(robot_name="CAR", object_name="CUP", location_name="TABLE"; success->success4, message->msg4);
        check(success4 == true);
    }
}