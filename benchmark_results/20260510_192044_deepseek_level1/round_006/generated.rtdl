def task PickAndPlace(;){ state pick_success: bool; state place_success: bool; state message: string; sequence{ do NavTo(robot_name="CAR", x=2.0, y=2.0, tolerance=0.5; success->pick_success, message->message); check(pick_success == true); do Pick(robot_name="CAR", object_name="CUP"; success->pick_success, message->message); check(pick_success == true); do NavTo(robot_name="CAR", x=-1.9993833402368157, y=1.9999984151863683, tolerance=0.5; success->place_success, message->message); check(place_success == true); do Place(robot_name="CAR", object_name="CUP", location_name="TABLE"; success->place_success, message->message); } }