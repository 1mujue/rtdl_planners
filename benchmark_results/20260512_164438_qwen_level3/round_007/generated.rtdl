def task remove_middle_box(;){
    state s1: bool;
    state s2: bool;
    state s3: bool;
    state s4: bool;
    state s5: bool;
    state s6: bool;
    state s7: bool;
    state s8: bool;
    state s9: bool;
    state s10: bool;
    state s11: bool;
    state s12: bool;
    sequence{
        do NavTo(robot_name="CAR", x=2.0, y=-1.0, tolerance=0.5; success->s1);
        check(s1 == true);
        do Pick(robot_name="CAR", object_name="BOX_TOP"; success->s2);
        check(s2 == true);
        do NavTo(robot_name="CAR", x=-2.2, y=-1.8, tolerance=0.5; success->s3);
        check(s3 == true);
        do Place(robot_name="CAR", object_name="BOX_TOP", location_name="TEMP_TABLE"; success->s4);
        check(s4 == true);
        do NavTo(robot_name="CAR", x=2.0, y=-1.0, tolerance=0.5; success->s5);
        check(s5 == true);
        do Pick(robot_name="CAR", object_name="BOX_MIDDLE"; success->s6);
        check(s6 == true);
        do NavTo(robot_name="CAR", x=-2.2, y=2.0, tolerance=0.5; success->s7);
        check(s7 == true);
        do Place(robot_name="CAR", object_name="BOX_MIDDLE", location_name="INSPECTION_TABLE"; success->s8);
        check(s8 == true);
        do NavTo(robot_name="CAR", x=-2.2, y=-1.8, tolerance=0.5; success->s9);
        check(s9 == true);
        do Pick(robot_name="CAR", object_name="BOX_TOP"; success->s10);
        check(s10 == true);
        do NavTo(robot_name="CAR", x=2.0, y=-1.0, tolerance=0.5; success->s11);
        check(s11 == true);
        do Place(robot_name="CAR", object_name="BOX_TOP", location_name="BOX_BOTTOM"; success->s12);
        check(s12 == true);
    }
}