def task move_middle_box(;){
    state nav_ok: bool;
    state nav_msg: string;
    state pick_ok: bool;
    state pick_msg: string;
    state place_ok: bool;
    state place_msg: string;

    sequence{
        retry(2) do NavTo(robot_name="CAR", x=2.0, y=-1.0, tolerance=0.5; success->nav_ok, message->nav_msg);
        check(nav_ok == true);
        retry(2) do Pick(robot_name="CAR", object_name="BOX_TOP"; success->pick_ok, message->pick_msg);
        check(pick_ok == true);
        retry(2) do NavTo(robot_name="CAR", x=-2.2, y=-1.8, tolerance=0.5; success->nav_ok, message->nav_msg);
        check(nav_ok == true);
        retry(2) do Place(robot_name="CAR", object_name="BOX_TOP", location_name="TEMP_TABLE"; success->place_ok, message->place_msg);
        check(place_ok == true);

        retry(2) do NavTo(robot_name="CAR", x=2.0, y=-1.0, tolerance=0.5; success->nav_ok, message->nav_msg);
        check(nav_ok == true);
        retry(2) do Pick(robot_name="CAR", object_name="BOX_MIDDLE"; success->pick_ok, message->pick_msg);
        check(pick_ok == true);
        retry(2) do NavTo(robot_name="CAR", x=-2.2, y=2.0, tolerance=0.5; success->nav_ok, message->nav_msg);
        check(nav_ok == true);
        retry(2) do Place(robot_name="CAR", object_name="BOX_MIDDLE", location_name="INSPECTION_TABLE"; success->place_ok, message->place_msg);
        check(place_ok == true);

        retry(2) do NavTo(robot_name="CAR", x=-2.2, y=-1.8, tolerance=0.5; success->nav_ok, message->nav_msg);
        check(nav_ok == true);
        retry(2) do Pick(robot_name="CAR", object_name="BOX_TOP"; success->pick_ok, message->pick_msg);
        check(pick_ok == true);
        retry(2) do NavTo(robot_name="CAR", x=-2.2, y=2.0, tolerance=0.5; success->nav_ok, message->nav_msg);
        check(nav_ok == true);
        retry(2) do Place(robot_name="CAR", object_name="BOX_TOP", location_name="INSPECTION_TABLE"; success->place_ok, message->place_msg);
        check(place_ok == true);
    }
}