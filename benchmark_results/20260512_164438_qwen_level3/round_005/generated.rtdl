def task MoveBoxMiddle(;){
    state nav1_ok: bool;
    state msg1: string;
    state pick1_ok: bool;
    state msg2: string;
    state nav2_ok: bool;
    state msg3: string;
    state place1_ok: bool;
    state msg4: string;
    state nav3_ok: bool;
    state msg5: string;
    state pick2_ok: bool;
    state msg6: string;
    state nav4_ok: bool;
    state msg7: string;
    state place2_ok: bool;
    state msg8: string;
    state nav5_ok: bool;
    state msg9: string;
    state pick3_ok: bool;
    state msg10: string;
    state nav6_ok: bool;
    state msg11: string;
    state place3_ok: bool;
    state msg12: string;
    sequence{
        do NavTo(robot_name="CAR", x=2.0, y=-1.0, tolerance=0.5; success->nav1_ok, message->msg1);
        check(nav1_ok == true);
        do Pick(robot_name="CAR", object_name="BOX_TOP"; success->pick1_ok, message->msg2);
        check(pick1_ok == true);
        do NavTo(robot_name="CAR", x=-2.2, y=-1.8, tolerance=0.5; success->nav2_ok, message->msg3);
        check(nav2_ok == true);
        do Place(robot_name="CAR", object_name="BOX_TOP", location_name="TEMP_TABLE"; success->place1_ok, message->msg4);
        check(place1_ok == true);
        do NavTo(robot_name="CAR", x=2.0, y=-1.0, tolerance=0.5; success->nav3_ok, message->msg5);
        check(nav3_ok == true);
        do Pick(robot_name="CAR", object_name="BOX_MIDDLE"; success->pick2_ok, message->msg6);
        check(pick2_ok == true);
        do NavTo(robot_name="CAR", x=-2.2, y=2.0, tolerance=0.5; success->nav4_ok, message->msg7);
        check(nav4_ok == true);
        do Place(robot_name="CAR", object_name="BOX_MIDDLE", location_name="INSPECTION_TABLE"; success->place2_ok, message->msg8);
        check(place2_ok == true);
        do NavTo(robot_name="CAR", x=-2.2, y=-1.8, tolerance=0.5; success->nav5_ok, message->msg9);
        check(nav5_ok == true);
        do Pick(robot_name="CAR", object_name="BOX_TOP"; success->pick3_ok, message->msg10);
        check(pick3_ok == true);
        do NavTo(robot_name="CAR", x=2.0, y=-1.0, tolerance=0.5; success->nav6_ok, message->msg11);
        check(nav6_ok == true);
        do Place(robot_name="CAR", object_name="BOX_TOP", location_name="BOX_BOTTOM"; success->place3_ok, message->msg12);
        check(place3_ok == true);
    }
}