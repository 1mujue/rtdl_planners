def task PlaceMedicineBottleAfterRemovingObstacle(;){ state nav_success1: bool; state nav_msg1: string; state pick_success1: bool; state pick_msg1: string; state nav_success2: bool; state nav_msg2: string; state place_success1: bool; state place_msg1: string; state nav_success3: bool; state nav_msg3: string; state pick_success2: bool; state pick_msg2: string; state nav_success4: bool; state nav_msg4: string; state place_success2: bool; state place_msg2: string; sequence{ do NavTo(robot_name="CAR",x=1.85,y=1.50,tolerance=0.5;success->nav_success1,message->nav_msg1); check(nav_success1 == true); do Pick(robot_name="CAR",object_name="FRONT_CRATE";success->pick_success1,message->pick_msg1); check(pick_success1 == true); do NavTo(robot_name="CAR",x=-2.0,y=-1.8,tolerance=0.5;success->nav_success2,message->nav_msg2); check(nav_success2 == true); do Place(robot_name="CAR",object_name="FRONT_CRATE",location_name="TEMP_ZONE";success->place_success1,message->place_msg1); check(place_success1 == true); do NavTo(robot_name="CAR",x=2.55,y=1.5,tolerance=0.5;success->nav_success3,message->nav_msg3); check(nav_success3 == true); do Pick(robot_name="CAR",object_name="MEDICINE_BOTTLE";success->pick_success2,message->pick_msg2); check(pick_success2 == true); do NavTo(robot_name="CAR",x=-2.3,y=2.0,tolerance=0.5;success->nav_success4,message->nav_msg4); check(nav_success4 == true); do Place(robot_name="CAR",object_name="MEDICINE_BOTTLE",location_name="MEDICAL_TABLE";success->place_success2,message->place_msg2); check(place_success2 == true); } }