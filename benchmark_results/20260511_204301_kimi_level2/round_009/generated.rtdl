def task PlaceMedicineAfterRemovingObstacle(;){ state nav_success: bool; state pick_success: bool; state place_success: bool; state msg: string; sequence{ do NavTo(robot_name="CAR",x=1.85,y=1.5,tolerance=0.5;success->nav_success,message->msg); check(nav_success == true); do Pick(robot_name="CAR",object_name="FRONT_CRATE";success->pick_success,message->msg); check(pick_success == true); do NavTo(robot_name="CAR",x=-2.0,y=-1.8,tolerance=0.5;success->nav_success,message->msg); check(nav_success == true); do Place(robot_name="CAR",object_name="FRONT_CRATE",location_name="TEMP_ZONE";success->place_success,message->msg); check(place_success == true); do NavTo(robot_name="CAR",x=2.55,y=1.5,tolerance=0.5;success->nav_success,message->msg); check(nav_success == true); do Pick(robot_name="CAR",object_name="MEDICINE_BOTTLE";success->pick_success,message->msg); check(pick_success == true); do NavTo(robot_name="CAR",x=-2.3,y=2.0,tolerance=0.5;success->nav_success,message->msg); check(nav_success == true); do Place(robot_name="CAR",object_name="MEDICINE_BOTTLE",location_name="MEDICAL_TABLE";success->place_success,message->msg); check(place_success == true); } }