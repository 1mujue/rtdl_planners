def task PlaceMedicineOnTable(;){ state nav_to_bottle_success: bool; state nav_to_bottle_msg: string; state pick_success: bool; state pick_msg: string; state nav_to_table_success: bool; state nav_to_table_msg: string; state place_success: bool; state place_msg: string; 
sequence{ 
    retry(3) do NavTo(robot_name="CAR",x=2.55,y=1.5,tolerance=0.5;success->nav_to_bottle_success,message->nav_to_bottle_msg); 
    check(nav_to_bottle_success == true); 
    do Pick(robot_name="CAR",object_name="MEDICINE_BOTTLE";success->pick_success,message->pick_msg); 
    check(pick_success == true); 
    retry(3) do NavTo(robot_name="CAR",x=-2.3,y=2.0,tolerance=0.5;success->nav_to_table_success,message->nav_to_table_msg); 
    check(nav_to_table_success == true); 
    do Place(robot_name="CAR",object_name="MEDICINE_BOTTLE",location_name="MEDICAL_TABLE";success->place_success,message->place_msg); 
    check(place_success == true); 
    } 
}