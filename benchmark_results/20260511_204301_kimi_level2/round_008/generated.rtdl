def task PlaceMedicineAfterRemovingObstacle(;){ state nav_success: bool; state pick_success: bool; state place_success: bool; state msg: string; sequence{ // Step 1: Navigate to FRONT_CRATE to remove it do NavTo(robot_name="CAR",x=1.85,y=1.5,tolerance=0.5;success->nav_success,message->msg); check(nav_success == true); // Step 2: Pick up FRONT_CRATE do Pick(robot_name="CAR",object_name="FRONT_CRATE";success->pick_success,message->msg); check(pick_success == true); // Step 3: Navigate to TEMP_ZONE to place the crate do NavTo(robot_name="CAR",x=-2.0000000857986864,y=-1.8000000875511657,tolerance=0.5;success->nav_success,message->msg); check(nav_success == true); // Step 4: Place FRONT_CRATE at TEMP_ZONE do Place(robot_name="CAR",object_name="FRONT_CRATE",location_name="TEMP_ZONE";success->place_success,message->msg); check(place_success == true); // Step 5: Navigate to MEDICINE_BOTTLE do NavTo(robot_name="CAR",x=2.55,y=1.5,tolerance=0.5;success->nav_success,message->msg); check(nav_success == true); // Step 6: Pick up MEDICINE_BOTTLE do Pick(robot_name="CAR",object_name="MEDICINE_BOTTLE";success->pick_success,message->msg); check(pick_success == true); // Step 7: Navigate to MEDICAL_TABLE do NavTo(robot_name="CAR",x=-2.3,y=2.0,tolerance=0.5;success->nav_success,message->msg); check(nav_success == true); // Step 8: Place MEDICINE_BOTTLE on MEDICAL_TABLE do Place(robot_name="CAR",object_name="MEDICINE_BOTTLE",location_name="MEDICAL_TABLE";success->place_success,message->msg); check(place_success == true); } }