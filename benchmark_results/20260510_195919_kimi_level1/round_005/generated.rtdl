def task PickAndPlaceCup(;){ state nav_to_cup_success: bool; state pick_success: bool; state nav_to_table_success: bool; state place_success: bool; state msg1: string; state msg2: string; state msg3: string; state msg4: string; sequence{ do NavTo(robot_name="CAR",x=2.0,y=2.0,tolerance=0.5;success->nav_to_cup_success,message->msg1); check(nav_to_cup_success == true); do Pick(robot_name="CAR",object_name="CUP";success->pick_success,message->msg2); check(pick_success == true); do NavTo(robot_name="CAR",x=-1.9995273234412698,y=1.999998500939493,tolerance=0.5;success->nav_to_table_success,message->msg3); check(nav_to_table_success == true); do Place(robot_name="CAR",object_name="CUP",location_name="TABLE";success->place_success,message->msg4); check(place_success == true); } }