def task PickCupPlaceOnTable(;){ state nav_to_cup_success: bool; state pick_success: bool; state nav_to_table_success: bool; state place_success: bool; state msg: string; sequence{ do NavTo(robot_name="CAR",x=2.0,y=2.0,tolerance=0.5;success->nav_to_cup_success,message->msg); check(nav_to_cup_success == true); do Pick(robot_name="CAR",object_name="CUP";success->pick_success,message->msg); check(pick_success == true); do NavTo(robot_name="CAR",x=-1.9996669969305472,y=1.9999985486949907,tolerance=0.5;success->nav_to_table_success,message->msg); check(nav_to_table_success == true); do Place(robot_name="CAR",object_name="CUP",location_name="TABLE";success->place_success,message->msg); check(place_success == true); } }