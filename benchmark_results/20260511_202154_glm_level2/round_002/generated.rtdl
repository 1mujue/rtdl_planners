def task place_medicine_on_table(;){
    state s1: bool;
    state m1: string;
    state s2: bool;
    state m2: string;
    state s3: bool;
    state m3: string;
    state s4: bool;
    state m4: string;
    state s5: bool;
    state m5: string;
    state s6: bool;
    state m6: string;
    state s7: bool;
    state m7: string;

    sequence{
        do Pick(robot_name="CAR", object_name="FRONT_CRATE"; success->s1, message->m1);
        check(s1 == true);
        do NavTo(robot_name="CAR", x=-2.0, y=-1.8, tolerance=0.5; success->s2, message->m2);
        check(s2 == true);
        do Place(robot_name="CAR", object_name="FRONT_CRATE", location_name="TEMP_ZONE"; success->s3, message->m3);
        check(s3 == true);
        do NavTo(robot_name="CAR", x=2.55, y=1.5, tolerance=0.5; success->s4, message->m4);
        check(s4 == true);
        do Pick(robot_name="CAR", object_name="MEDICINE_BOTTLE"; success->s5, message->m5);
        check(s5 == true);
        do NavTo(robot_name="CAR", x=-2.3, y=2.0, tolerance=0.5; success->s6, message->m6);
        check(s6 == true);
        do Place(robot_name="CAR", object_name="MEDICINE_BOTTLE", location_name="MEDICAL_TABLE"; success->s7, message->m7);
        check(s7 == true);
    }
}