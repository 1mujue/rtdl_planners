def task PlaceMedicineOnTable(;){
    state pick1_ok: bool;
    state nav1_ok: bool;
    state place1_ok: bool;
    state nav2_ok: bool;
    state pick2_ok: bool;
    state nav3_ok: bool;
    state place2_ok: bool;

    sequence{
        do Pick(robot_name="CAR", object_name="FRONT_CRATE"; success->pick1_ok);
        check(pick1_ok == true);
        do NavTo(robot_name="CAR", x=-2.0, y=-1.8, tolerance=2.0; success->nav1_ok);
        check(nav1_ok == true);
        do Place(robot_name="CAR", object_name="FRONT_CRATE", location_name="TEMP_ZONE"; success->place1_ok);
        check(place1_ok == true);
        do NavTo(robot_name="CAR", x=2.55, y=1.5, tolerance=2.0; success->nav2_ok);
        check(nav2_ok == true);
        do Pick(robot_name="CAR", object_name="MEDICINE_BOTTLE"; success->pick2_ok);
        check(pick2_ok == true);
        do NavTo(robot_name="CAR", x=-2.3, y=2.0, tolerance=2.0; success->nav3_ok);
        check(nav3_ok == true);
        do Place(robot_name="CAR", object_name="MEDICINE_BOTTLE", location_name="MEDICAL_TABLE"; success->place2_ok);
        check(place2_ok == true);
    }
}