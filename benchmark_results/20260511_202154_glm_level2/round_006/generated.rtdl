def task place_medicine_on_table_after_removing_obstacle(;){
    state nav_ok1: bool;
    state msg1: string;
    state pick_ok1: bool;
    state msg2: string;
    state nav_ok2: bool;
    state msg3: string;
    state place_ok1: bool;
    state msg4: string;
    state nav_ok3: bool;
    state msg5: string;
    state pick_ok2: bool;
    state msg6: string;
    state nav_ok4: bool;
    state msg7: string;
    state place_ok2: bool;
    state msg8: string;

    sequence{
        do NavTo(robot_name="CAR",x=1.8497,y=1.4998,tolerance=0.5;success->nav_ok1,message->msg1);
        check(nav_ok1==true);
        do Pick(robot_name="CAR",object_name="FRONT_CRATE";success->pick_ok1,message->msg2);
        check(pick_ok1==true);
        do NavTo(robot_name="CAR",x=-1.9999,y=-1.7999,tolerance=0.5;success->nav_ok2,message->msg3);
        check(nav_ok2==true);
        do Place(robot_name="CAR",object_name="FRONT_CRATE",location_name="TEMP_ZONE";success->place_ok1,message->msg4);
        check(place_ok1==true);
        do NavTo(robot_name="CAR",x=2.55,y=1.5,tolerance=0.5;success->nav_ok3,message->msg5);
        check(nav_ok3==true);
        do Pick(robot_name="CAR",object_name="MEDICINE_BOTTLE";success->pick_ok2,message->msg6);
        check(pick_ok2==true);
        do NavTo(robot_name="CAR",x=-2.3,y=2.0,tolerance=0.5;success->nav_ok4,message->msg7);
        check(nav_ok4==true);
        do Place(robot_name="CAR",object_name="MEDICINE_BOTTLE",location_name="MEDICAL_TABLE";success->place_ok2,message->msg8);
        check(place_ok2==true);
    }
}