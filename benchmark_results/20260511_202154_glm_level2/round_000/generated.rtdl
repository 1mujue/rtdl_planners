def task place_medicine_after_removing_obstacle(;){
    state nav_success: bool;
    state nav_msg: string;
    state pick_success: bool;
    state pick_msg: string;
    state place_success: bool;
    state place_msg: string;

    sequence{
        retry(3) do NavTo(robot_name="CAR", x=1.5, y=1.5, tolerance=0.5; success->nav_success, message->nav_msg);
        check(nav_success == true);
        do Pick(robot_name="CAR", object_name="FRONT_CRATE"; success->pick_success, message->pick_msg);
        check(pick_success == true);
        retry(3) do NavTo(robot_name="CAR", x=-1.5, y=-1.5, tolerance=0.5; success->nav_success, message->nav_msg);
        check(nav_success == true);
        do Place(robot_name="CAR", object_name="FRONT_CRATE", location_name="TEMP_ZONE"; success->place_success, message->place_msg);
        check(place_success == true);
        retry(3) do NavTo(robot_name="CAR", x=2.2, y=1.5, tolerance=0.5; success->nav_success, message->nav_msg);
        check(nav_success == true);
        do Pick(robot_name="CAR", object_name="MEDICINE_BOTTLE"; success->pick_success, message->pick_msg);
        check(pick_success == true);
        retry(3) do NavTo(robot_name="CAR", x=-2.0, y=2.0, tolerance=0.5; success->nav_success, message->nav_msg);
        check(nav_success == true);
        do Place(robot_name="CAR", object_name="MEDICINE_BOTTLE", location_name="MEDICAL_TABLE"; success->place_success, message->place_msg);
        check(place_success == true);
    }
}