def task PlaceMedicineAfterRemovingObstacle(;){
    state nav1_ok: bool;
    state nav1_msg: string;
    state pick1_ok: bool;
    state pick1_msg: string;
    state nav2_ok: bool;
    state nav2_msg: string;
    state place1_ok: bool;
    state place1_msg: string;
    state nav3_ok: bool;
    state nav3_msg: string;
    state pick2_ok: bool;
    state pick2_msg: string;
    state nav4_ok: bool;
    state nav4_msg: string;
    state place2_ok: bool;
    state place2_msg: string;

    sequence{
        retry(3) do NavTo(robot_name="CAR", x=1.8494109802496919, y=1.4995048193478073, tolerance=0.5; success->nav1_ok, message->nav1_msg);
        check(nav1_ok == true);
        do Pick(robot_name="CAR", object_name="FRONT_CRATE"; success->pick1_ok, message->pick1_msg);
        check(pick1_ok == true);
        retry(3) do NavTo(robot_name="CAR", x=-1.9999711453095508, y=-1.7999705764724692, tolerance=0.5; success->nav2_ok, message->nav2_msg);
        check(nav2_ok == true);
        do Place(robot_name="CAR", object_name="FRONT_CRATE", location_name="TEMP_ZONE"; success->place1_ok, message->place1_msg);
        check(place1_ok == true);
        retry(3) do NavTo(robot_name="CAR", x=2.55, y=1.5, tolerance=0.5; success->nav3_ok, message->nav3_msg);
        check(nav3_ok == true);
        do Pick(robot_name="CAR", object_name="MEDICINE_BOTTLE"; success->pick2_ok, message->pick2_msg);
        check(pick2_ok == true);
        retry(3) do NavTo(robot_name="CAR", x=-2.3, y=2.0, tolerance=0.5; success->nav4_ok, message->nav4_msg);
        check(nav4_ok == true);
        do Place(robot_name="CAR", object_name="MEDICINE_BOTTLE", location_name="MEDICAL_TABLE"; success->place2_ok, message->place2_msg);
        check(place2_ok == true);
    }
}