def task MoveMiddleBoxToInspection(;){
    state nav1_success: bool;
    state nav1_msg: string;
    state pick1_success: bool;
    state pick1_msg: string;
    state nav2_success: bool;
    state nav2_msg: string;
    state place1_success: bool;
    state place1_msg: string;
    state nav3_success: bool;
    state nav3_msg: string;
    state pick2_success: bool;
    state pick2_msg: string;
    state nav4_success: bool;
    state nav4_msg: string;
    state place2_success: bool;
    state place2_msg: string;
    state nav5_success: bool;
    state nav5_msg: string;
    state pick3_success: bool;
    state pick3_msg: string;
    state nav6_success: bool;
    state nav6_msg: string;
    state place3_success: bool;
    state place3_msg: string;

    sequence{
        retry(3) do NavTo(robot_name="CAR", x=2.0, y=-1.0, tolerance=0.5; success->nav1_success, message->nav1_msg);
        check(nav1_success == true);
        do Pick(robot_name="CAR", object_name="BOX_TOP"; success->pick1_success, message->pick1_msg);
        check(pick1_success == true);
        retry(3) do NavTo(robot_name="CAR", x=-2.2, y=-1.8, tolerance=0.5; success->nav2_success, message->nav2_msg);
        check(nav2_success == true);
        do Place(robot_name="CAR", object_name="BOX_TOP", location_name="TEMP_TABLE"; success->place1_success, message->place1_msg);
        check(place1_success == true);
        retry(3) do NavTo(robot_name="CAR", x=2.0, y=-1.0, tolerance=0.5; success->nav3_success, message->nav3_msg);
        check(nav3_success == true);
        do Pick(robot_name="CAR", object_name="BOX_MIDDLE"; success->pick2_success, message->pick2_msg);
        check(pick2_success == true);
        retry(3) do NavTo(robot_name="CAR", x=-2.2, y=2.0, tolerance=0.5; success->nav4_success, message->nav4_msg);
        check(nav4_success == true);
        do Place(robot_name="CAR", object_name="BOX_MIDDLE", location_name="INSPECTION_TABLE"; success->place2_success, message->place2_msg);
        check(place2_success == true);
        retry(3) do NavTo(robot_name="CAR", x=-2.2, y=-1.8, tolerance=0.5; success->nav5_success, message->nav5_msg);
        check(nav5_success == true);
        do Pick(robot_name="CAR", object_name="BOX_TOP"; success->pick3_success, message->pick3_msg);
        check(pick3_success == true);
        retry(3) do NavTo(robot_name="CAR", x=2.0, y=-1.0, tolerance=0.5; success->nav6_success, message->nav6_msg);
        check(nav6_success == true);
        do Place(robot_name="CAR", object_name="BOX_TOP", location_name="BOX_BOTTOM"; success->place3_success, message->place3_msg);
        check(place3_success == true);
    }
}