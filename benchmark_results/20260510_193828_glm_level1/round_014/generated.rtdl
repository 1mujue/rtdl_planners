def task PickAndPlaceCup(;){
    state nav_success1: bool;
    state nav_message1: string;
    state pick_success: bool;
    state pick_message: string;
    state nav_success2: bool;
    state nav_message2: string;
    state place_success: bool;
    state place_message: string;

    sequence{
        do NavTo(robot_name="CAR", x=2.0, y=2.0, tolerance=0.5; success->nav_success1, message->nav_message1);
        check(nav_success1 == true);
        do Pick(robot_name="CAR", object_name="CUP"; success->pick_success, message->pick_message);
        check(pick_success == true);
        do NavTo(robot_name="CAR", x=-2.0, y=2.0, tolerance=0.5; success->nav_success2, message->nav_message2);
        check(nav_success2 == true);
        do Place(robot_name="CAR", object_name="CUP", location_name="TABLE"; success->place_success, message->place_message);
        check(place_success == true);
    }
}