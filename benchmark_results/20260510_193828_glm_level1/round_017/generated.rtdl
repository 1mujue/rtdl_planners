def task pick_and_place_cup(;){
    state nav_success1: bool;
    state msg1: string;
    state pick_success: bool;
    state msg2: string;
    state nav_success2: bool;
    state msg3: string;
    state place_success: bool;
    state msg4: string;

    sequence{
        do NavTo(robot_name="CAR",x=2.0,y=2.0,tolerance=1.5;success->nav_success1,message->msg1);
        check(nav_success1 == true);
        do Pick(robot_name="CAR",object_name="CUP";success->pick_success,message->msg2);
        check(pick_success == true);
        do NavTo(robot_name="CAR",x=-2.0,y=2.0,tolerance=1.5;success->nav_success2,message->msg3);
        check(nav_success2 == true);
        do Place(robot_name="CAR",object_name="CUP",location_name="TABLE";success->place_success,message->msg4);
        check(place_success == true);
    }
}